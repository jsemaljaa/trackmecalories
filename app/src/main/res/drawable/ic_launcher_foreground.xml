<?xml version="1.0" encoding="utf-8"?>
<!--
  App icon foreground: a calorie-progress ring (mint fading to amber, the brand's
  "nutrition" and "energy" colours, echoing the ring on Home) around a leaf.
  Everything stays inside the 66dp safe zone of the 108dp adaptive-icon canvas.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ring track -->
    <path
        android:pathData="M54,32a22,22 0,1 1,0 44a22,22 0,1 1,0 -44"
        android:strokeWidth="6.5"
        android:strokeColor="#29FFFFFF" />

    <!-- Progress arc, 290 degrees from 12 o'clock. Rotated so the sweep gradient
         (which starts at 3 o'clock) begins where the arc does. -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-90">
        <path
            android:pathData="M76,54A22,22 0,1 1,61.52 33.33"
            android:strokeWidth="6.5"
            android:strokeLineCap="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:centerX="54"
                    android:centerY="54"
                    android:type="sweep">
                    <item android:color="#FFA6F2C5" android:offset="0.0" />
                    <item android:color="#FFF6C453" android:offset="0.806" />
                    <item android:color="#FFF6C453" android:offset="0.88" />
                    <!-- back to mint so the start cap (just before 0) isn't amber -->
                    <item android:color="#FFA6F2C5" android:offset="0.93" />
                    <item android:color="#FFA6F2C5" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>
    </group>

    <!-- Leaf with its vein cut out -->
    <path
        android:fillColor="#FFF4FFF8"
        android:fillType="evenOdd"
        android:pathData="M44.2,63.8C44.2,50.6 52.3,43.6 64.4,43.6C64.4,55.7 57.5,63.8 44.2,63.8Z M45.86,60.86L57.36,49.36L58.64,50.64L47.14,62.14Z" />
</vector>
