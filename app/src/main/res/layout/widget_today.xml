<?xml version="1.0" encoding="utf-8"?>
<!-- Today widget: calories left, eaten / goal, and three one-tap actions. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_left_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_text"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_left_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="6dp"
            android:textColor="@color/widget_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/widget_progress"
        style="@android:style/Widget.Material.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progressBackgroundTint="@color/widget_track"
        android:progressTint="@color/widget_accent" />

    <TextView
        android:id="@+id/widget_eaten"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/widget_text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_add"
            style="@style/WidgetButton"
            android:text="@string/widget_add" />

        <TextView
            android:id="@+id/widget_quick"
            style="@style/WidgetButton"
            android:layout_marginStart="8dp"
            android:text="@string/widget_quick" />

        <TextView
            android:id="@+id/widget_scan"
            style="@style/WidgetButton"
            android:layout_marginStart="8dp"
            android:text="@string/widget_scan" />
    </LinearLayout>
</LinearLayout>
